# Copy this file to backend/.env and fill in the values.

# --- Language model (required) ---------------------------------------------
# gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini
# Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=
# Leave empty for the provider's default (gemini-3.5-flash on Gemini).
# Run `.venv\Scripts\python check_model.py` to see which models answer quickly for your key.
LLM_MODEL=
# Backup model used automatically while the main one is overloaded or rate-limited
# (empty = gemini-3.1-flash-lite on Gemini, "none" = no backup).
LLM_FALLBACK_MODEL=
# How long the model thinks before answering: low | medium | high,
# or "default" to leave it to the provider. Empty = "low" on Gemini, which
# keeps answers fast on the free tier.
LLM_REASONING_EFFORT=
# Seconds to wait for one model reply.
LLM_TIMEOUT_SECONDS=150
# Embeddings for semantic search. "none" uses keyword (BM25) ranking only.
EMBEDDING_MODEL=gemini-embedding-001

# --- Gmail (optional) ------------------------------------------------------
# OAuth client from Google Cloud Console (see README: "Connect Gmail").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notion (optional) -----------------------------------------------------
# Easiest: an internal integration token (see README: "Connect Notion").
NOTION_TOKEN=
# Or a public integration's OAuth client, to connect with a button in the app.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- App -------------------------------------------------------------------
# Use sample emails and Notion pages for any source that isn't connected.
DEMO_MODE=true
BACKEND_URL=http://localhost:8000
# Where to send you back after connecting an account.
# Use http://localhost:8000 if you serve the built frontend from the backend.
FRONTEND_URL=http://localhost:5173
# Encrypts stored sign-in tokens. Leave empty to generate one in backend/data/.secret
APP_SECRET=
